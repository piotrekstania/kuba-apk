{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "generator-operatow-windows",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["uruchom.py"],
      "port": 8000
    },
    {
      "name": "generator-operatow-windows-8001",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "generator-operatow",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["uruchom.py"],
      "port": 8000
    }
  ]
}
